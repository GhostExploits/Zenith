{
  "name": "zenith-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Official website for Zenith — premium Minecraft client. Public site, account portal, and secure admin foundation.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "test": "vitest run",
    "seed": "node scripts/seed.mjs",
    "db:create": "wrangler d1 create zenith",
    "db:migrate": "wrangler d1 execute zenith --remote --file=migrations/0001_init.sql",
    "db:migrate:local": "wrangler d1 execute zenith --local --file=migrations/0001_init.sql",
    "r2:create": "wrangler r2 bucket create zenith-releases",
    "assets:logo": "node scripts/optimize-logo.mjs",
    "assets:favicon": "node scripts/make-favicon.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.4.2",
    "@fontsource-variable/inter": "^5.2.6",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.2.6",
    "arctic": "^3.7.0",
    "astro": "^5.12.0",
    "nodemailer": "^9.0.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/sitemap": "^3.4.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "sharp": "^0.35.3",
    "typescript": "^5.8.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.0.0"
  }
}
