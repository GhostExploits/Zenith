[TEMPLATE]
# ============================================================================
# Zenith — environment variables (development)
# ============================================================================
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# All values below are placeholders. Nothing here is a real credential.

# --- Site ---
PUBLIC_SITE_URL=https://zenithv2.pages.dev

# --- Server secrets ---
# Used to sign session cookies and CSRF tokens. Generate with:
#   openssl rand -hex 32
# In production, prefer a Cloudflare secret binding instead of an env var.
AUTH_SECRET=replace-with-a-long-random-hex-string

# --- Dev bootstrap account (development only) ---
# Used by the auto-seed to create the initial admin. In production the admin
# account is created by the same seed when the D1 database is first used —
# ADMIN_EMAIL / ADMIN_PASSWORD must be set as Cloudflare secrets so the owner
# account is created correctly. Set ADMIN_EMAIL to YOUR Google email.
ADMIN_EMAIL=admin@zenith.local
ADMIN_PASSWORD=zenith-dev-admin

# --- Database ---
# Dev uses a JSON-file store under ./data (auto-seeded). Production uses the
# Cloudflare D1 database bound as DB (see wrangler.toml) — no env var needed.
DATABASE_PROVIDER=json
DATABASE_URL=

# --- Payment provider (Paddle) ---
# IMPORTANT: payments are in MAINTENANCE MODE until you deliberately set
# PAYMENTS_ENABLED=true. Even if the Paddle credentials below are present,
# nobody can be charged, no provider API is called, and no webhook is
# processed while the flag is off (or unset). The store stays fully browsable;
# only the actual purchase action is blocked.
PAYMENTS_ENABLED=false

# Zenith uses Paddle (a Merchant of Record): it handles payment methods,
# taxes, and compliance, so no card data ever reaches this server.
# When you are ready to go live:
#   1. Set PAYMENTS_ENABLED=true as a Cloudflare secret.
#   2. Sign up at https://vendor.paddle.com, create an API key (Settings → API
#      keys, "Paddle API" with transactions + subscriptions scopes).
#   3. Add a webhook notification (Developer tools → Notifications → Add
#      destination, URL https://<your-domain>/api/payments/webhook, event type
#      "All") and paste its secret below.
PAYMENT_PROVIDER=paddle
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=

# --- License authority (Zenith client) ---
# The Zenith client (VapeV4.21) verifies every license locally against the
# Ed25519 public key EMBEDDED IN THE CLIENT. The website signs licenses with
# the matching PRIVATE key — these are the two files in your VapeService data
# directory (dist/service/data/):
#   LICENSE_SIGNING_KEY         -> contents of license-signing.key  (PKCS8 PEM)
#   LICENSE_SIGNING_PUBLIC_KEY  -> contents of license-signing.pub (X.509 PEM)
# Without the real key, development works with an ephemeral key, but real
# Zenith clients will REJECT the licenses. Never commit these files.
LICENSE_SIGNING_KEY=
LICENSE_SIGNING_PUBLIC_KEY=

# --- Storage ---
# Protected release files live under ./data/storage in dev. In production they
# are stored in the Cloudflare R2 bucket bound as STORAGE (see wrangler.toml) —
# no env vars needed for R2. Keep the vars below only if you later switch to
# S3-compatible storage.
STORAGE_PROVIDER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# --- Google OAuth (server-side only — never exposed to the browser) ---
# If Google shows "Authorization not configured" (403 access_denied) after
# clicking "Continue with Google", the problem is in the Google Cloud Console
# project, not this site's code (that string is not produced here). Fix:
#   1. Create the OAuth client at https://console.cloud.google.com/apis/credentials
#      (OAuth 2.0 Client ID → Web application). Use the SAME Google Cloud
#      project for both the client and the consent screen.
#   2. Configure the OAuth consent screen (APIs & Services → OAuth consent
#      screen): app name, support email, and scope "email" + "profile".
#      For testing, add your own email under "Test users".
#   3. Under "Authorized redirect URIs" add EXACTLY the value of
#      GOOGLE_REDIRECT_URI below — no trailing slash, same protocol/domain:
#      Local:       http://127.0.0.1:4321/api/auth/google/callback
#      Production:  https://zenithv2.pages.dev/api/auth/google/callback
#   4. If the redirect URI in the console does not match GOOGLE_REDIRECT_URI
#      exactly, Google rejects the sign-in — fix the console entry.
# Email + password signup works even without Google OAuth configured (the
# button is simply hidden). Check /hq/status as the owner for live diagnostics.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:4321/api/auth/google/callback

# --- Email delivery ---
# EMAIL_TRANSPORT controls how transactional email (verification, password
# reset, license keys) is sent:
#   console = print to the server log (default; dev only — nothing is sent)
#   smtp    = SMTP via nodemailer (dev/self-hosted; NOT available on
#             Cloudflare Workers — use `http` there instead)
#   http    = generic transactional HTTP API (Resend-compatible:
#             POST {url}/emails with Bearer {key}; body {from,to,subject,html})
EMAIL_TRANSPORT=console
EMAIL_FROM=no-reply@zenithv2.pages.dev
EMAIL_FROM_NAME=Zenith

# SMTP (only when EMAIL_TRANSPORT=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# HTTP API (only when EMAIL_TRANSPORT=http) — e.g. a Resend API key
EMAIL_API_URL=
EMAIL_API_KEY=
