# ============================================================================
# Zenith — environment variables (development)
# ============================================================================
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# All values below are placeholders. Nothing here is a real credential.

# --- Site ---
# Placeholder domain until production is configured.
PUBLIC_SITE_URL=https://zenith.pages.dev

# --- Server secrets ---
# Used to sign session cookies and CSRF tokens. Generate with:
#   openssl rand -hex 32
# In production, prefer a Cloudflare secret binding instead of an env var.
AUTH_SECRET=replace-with-a-long-random-hex-string

# --- Dev bootstrap account (development only) ---
# Used by the auto-seed / `npm run seed` script to create the initial admin.
# In production the admin account must be created through a migration script
# against the real database — never from build-time env vars.
ADMIN_EMAIL=admin@zenith.local
ADMIN_PASSWORD=zenith-dev-admin

# --- Database (future) ---
# The current foundation uses a JSON-file store under ./data (dev only).
# When connecting a real database, set DATABASE_PROVIDER and the URL.
DATABASE_PROVIDER=json
DATABASE_URL=

# --- Payment provider (future) ---
# No payment provider is connected yet. These placeholders document the
# variables that will be required. Do not put real keys here.
PAYMENT_PROVIDER=
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# --- Storage (future) ---
# Protected release files currently live under ./data/storage (dev only).
# Later: Cloudflare R2 bucket + access key, or signed URL config.
STORAGE_PROVIDER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# --- Google OAuth (server-side only — never exposed to the browser) ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# (OAuth 2.0 Client ID → Web application).
#
# Authorized redirect URI must exactly match GOOGLE_REDIRECT_URI:
#   Local:    http://127.0.0.1:4321/api/auth/google/callback
#   Production: https://zenith.pages.dev/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:4321/api/auth/google/callback

# --- Email delivery ---
# EMAIL_TRANSPORT controls how transactional email (verification, password
# reset) is sent:
#   console = print to the server log (default; dev only — nothing is sent)
#   smtp    = SMTP via nodemailer (dev/self-hosted; NOT available on
#             Cloudflare Workers — use `http` there instead)
#   http    = generic transactional HTTP API (Resend-compatible:
#             POST {url}/emails with Bearer {key}; body {from,to,subject,html})
EMAIL_TRANSPORT=console
EMAIL_FROM=no-reply@zenith.pages.dev
EMAIL_FROM_NAME=Zenith

# SMTP (only when EMAIL_TRANSPORT=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# HTTP API (only when EMAIL_TRANSPORT=http) — e.g. a Resend API key
EMAIL_API_URL=
EMAIL_API_KEY=
