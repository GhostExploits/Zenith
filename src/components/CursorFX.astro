---
// Ambient pointer light + very subtle hero parallax.
//
// Desktop fine-pointer only: the layer is hidden with `(pointer: coarse)`
// and `(prefers-reduced-motion: reduce)`, and the script bails out when
// either media query matches. It never captures input (pointer-events: none),
// sits below sticky chrome, and animates only compositor-friendly properties
// (CSS custom properties driving background positions, plus `translate`).
---

<div class="cursor-fx" aria-hidden="true" data-cursor-fx>
  <div class="cursor-fx__glow"></div>
  <div class="cursor-fx__core"></div>
</div>

<style>
  .cursor-fx {
    position: fixed;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    opacity: 0;
    transition: opacity 500ms var(--ease);
  }

  .cursor-fx[data-active='true'] {
    opacity: 1;
  }

  .cursor-fx__glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(560px circle at var(--fx-x, 50%) var(--fx-y, 30%), rgba(255, 255, 255, 0.06), transparent 62%),
      radial-gradient(420px circle at var(--fx-x, 50%) var(--fx-y, 30%), rgba(255, 255, 255, 0.035), transparent 64%);
  }

  .cursor-fx__core {
    position: absolute;
    left: var(--fx-cx, 50%);
    top: var(--fx-cy, 30%);
    width: 12px;
    height: 12px;
    margin: -6px 0 0 -6px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.14), transparent 70%);
    filter: blur(2px);
  }

  @media (pointer: coarse) {
    .cursor-fx {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor-fx {
      display: none;
    }
  }
</style>

<script>
  const fx = document.querySelector<HTMLElement>('[data-cursor-fx]');
  const fine = window.matchMedia('(pointer: fine)').matches;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (fx && fine && !reduced) {
    const fxEl: HTMLElement = fx;
    let tx = window.innerWidth / 2;
    let ty = window.innerHeight / 3;
    let x = tx;
    let y = ty;
    let raf = 0;
    let active = false;

    // --- Parallax targets (elements with [data-parallax]) -----------------
    const parallaxEls = Array.from(document.querySelectorAll<HTMLElement>('[data-parallax]'));
    const inView = new Set<HTMLElement>();

    if ('IntersectionObserver' in window && parallaxEls.length) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            const el = entry.target as HTMLElement;
            if (entry.isIntersecting) {
              inView.add(el);
              el.style.willChange = 'translate';
            } else {
              inView.delete(el);
              el.style.willChange = '';
            }
          }
        },
        { threshold: 0 },
      );
      for (const el of parallaxEls) io.observe(el);
    } else {
      for (const el of parallaxEls) inView.add(el);
    }

    function step() {
      raf = 0;

      // Ease toward the pointer; different rates for glow vs. core feel.
      const glowK = 0.13;
      const coreK = 0.3;
      const gx = x + (tx - x) * glowK;
      const gy = y + (ty - y) * glowK;
      const cx = x + (tx - x) * coreK;
      const cy = y + (ty - y) * coreK;
      x = gx;
      y = gy;

      fxEl.style.setProperty('--fx-x', `${gx.toFixed(1)}px`);
      fxEl.style.setProperty('--fx-y', `${gy.toFixed(1)}px`);
      fxEl.style.setProperty('--fx-cx', `${cx.toFixed(1)}px`);
      fxEl.style.setProperty('--fx-cy', `${cy.toFixed(1)}px`);

      // Parallax: pointer offset from viewport center, normalized to ~-1..1,
      // scaled per-element by data-depth (px at full deflection).
      const nx = (x - window.innerWidth / 2) / (window.innerWidth / 2);
      const ny = (y - window.innerHeight / 2) / (window.innerHeight / 2);
      for (const el of inView) {
        const depth = parseFloat(el.dataset.depth ?? '1');
        el.style.setProperty('translate', `${(nx * depth).toFixed(2)}px ${(ny * depth).toFixed(2)}px`);
      }

      if (Math.abs(tx - x) > 0.1 || Math.abs(ty - y) > 0.1) {
        raf = requestAnimationFrame(step);
      }
    }

    window.addEventListener(
      'pointermove',
      (e: PointerEvent) => {
        tx = e.clientX;
        ty = e.clientY;
        if (!active) {
          // Snap on first move so the light doesn't sweep in from the corner.
          active = true;
          x = tx;
          y = ty;
          fxEl.setAttribute('data-active', 'true');
        }
        if (!raf) raf = requestAnimationFrame(step);
      },
      { passive: true },
    );

    // Never leave the light stranded after tab switches / focus changes.
    const snap = () => {
      x = tx;
      y = ty;
    };
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) snap();
    });
    window.addEventListener('blur', snap);
  }
</script>
