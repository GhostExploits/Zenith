---
/**
 * Gentle DevTools deterrent.
 *
 * The meaningful protection is architectural: the site's real source
 * (.astro/.ts), auth logic, database, and admin guards all run server-side
 * and never ship to the browser — what F12 sees is minified, sourcemap-free
 * output with no secrets. This component adds a small, dismissible notice
 * when the developer tools are opened, and a branding line in the console.
 *
 * It never blocks normal browsing, never traps the debugger, and is skipped
 * for reduced-motion users.
 */
---

<style>
  .devnotice {
    position: fixed;
    inset: auto 16px 16px auto;
    z-index: 300;
    max-width: 340px;
    background: var(--bg-raised);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.5);
    padding: 16px 16px 12px;
    animation: devnotice-in 200ms var(--ease);
  }
  .devnotice[hidden] { display: none; }
  .devnotice-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.92rem;
    margin-bottom: 4px;
  }
  .devnotice-close {
    background: none;
    border: none;
    color: var(--text-faint);
    cursor: pointer;
    font-size: 1.1rem;
    line-height: 1;
    padding: 2px 6px;
    border-radius: var(--radius-sm);
  }
  .devnotice-close:hover { color: var(--text); background: rgba(255, 255, 255, 0.06); }
  .devnotice p { margin: 0; color: var(--text-dim); font-size: 0.8rem; line-height: 1.45; }
  .devnotice code {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-faint);
  }
  @keyframes devnotice-in {
    from { opacity: 0; transform: translateY(6px); }
  }
</style>

<script>
  // Console branding — harmless, and marks the site as proprietary.
  console.log(
    '%cZenith%c — proprietary software. Please don\'t inspect or copy this site.',
    'font-weight:700;font-size:14px;color:#fff;',
    'color:#888;font-size:12px;',
  );

  // Detect an opened DevTools window via the classic viewport-width delta,
  // throttled so it costs nothing when closed. Dismissible, never blocking.
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const KEY = 'zenith-devnotice-seen';
    const el = document.querySelector<HTMLElement>('[data-devnotice]');
    const closeBtn = document.querySelector<HTMLButtonElement>('[data-devnotice-close]');
    const show = () => {
      if (el && !el.hidden && !sessionStorage.getItem(KEY)) {
        el.hidden = false;
        sessionStorage.setItem(KEY, '1');
      }
    };
    const detect = () => {
      const delta = (window.outerWidth - window.innerWidth) || 0;
      // DevTools docks right/left on desktop, widening the delta past ~160px.
      if (delta > 160 && window.innerWidth > 480) show();
    };
    closeBtn?.addEventListener('click', () => { if (el) el.hidden = true; });
    setInterval(detect, 2000);
  }
</script>

<div class="devnotice" data-devnotice hidden role="status" aria-live="polite">
  <div class="devnotice-head">
    <span>Zenith</span>
    <button class="devnotice-close" type="button" data-devnotice-close aria-label="Dismiss">×</button>
  </div>
  <p>
    This site's code is proprietary. What you see here is the compiled output —
    the source and server logic are not public.
  </p>
</div>
