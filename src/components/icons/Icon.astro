---

{
  icon ? (
    <svg
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill={filled ? 'currentColor' : 'none'}
      stroke={filled ? 'none' : 'currentColor'}
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      class:list={className}
      style={style}
      aria-hidden="true"
      set:html={icon}
    />
  ) : (
    <svg width={size} height={size} aria-hidden="true" />
  )
}
