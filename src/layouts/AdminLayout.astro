---
import AppLayout, { type AppLink } from './AppLayout.astro';
import type { User } from '../lib/types';

interface Props {
  title: string;
  description?: string;
  user: User;
}

const { title, description, user } = Astro.props;

const adminNav: AppLink[] = [
  { label: 'Dashboard', href: '/admin', icon: 'home' },
  { label: 'Users', href: '/admin/users', icon: 'users' },
  { label: 'Products', href: '/admin/products', icon: 'package' },
  { label: 'Plans', href: '/admin/plans', icon: 'credit-card' },
  { label: 'Releases', href: '/admin/releases', icon: 'download' },
  { label: 'FAQs', href: '/admin/faqs', icon: 'message' },
  { label: 'Announcements', href: '/admin/announcements', icon: 'bell' },
  { label: 'Site Content', href: '/admin/content', icon: 'edit' },
  { label: 'Audit Log', href: '/admin/audit', icon: 'activity' },
];
---

<AppLayout title={title} description={description} user={{ displayName: user.displayName, role: user.role }} nav={adminNav} noindex>
  <slot />
</AppLayout>
