---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import Icon from '../../components/icons/Icon.astro';
import GoogleButton from '../../components/GoogleButton.astro';
import { getSessionUser } from '../../lib/server/auth';
import { getStore } from '../../lib/server/store';

const store = await getStore();
const user = await getSessionUser(store, Astro.request).catch(() => null);
if (user) return Astro.redirect('/account');

const error = Astro.url.searchParams.get('error');
const errors: Record<string, string> = {
  invalid_email: 'Enter a valid email address.',
  weak_password: 'Your password must be at least 8 characters long.',
  password_mismatch: 'Those passwords don’t match.',
  invalid_name: 'Enter a display name.',
  email_taken: 'An account with that email already exists — try signing in instead.',
  rate_limited: 'Too many attempts. Please wait a few minutes before trying again.',
};
---

<MarketingLayout title="Create account" description="Create your Zenith account." noindex>
  <section class="auth-wrap">
    <div class="auth-card card card--pad-lg">
      <div class="auth-head">
        <h1>Create your account</h1>
        <p>One account for your products, subscriptions, and downloads.</p>
      </div>

      {error && errors[error] && <div class="form-error"><Icon name="alert-triangle" size={16} /> {errors[error]}</div>}

      <GoogleButton />

      <div class="or-divider"><span>or with email</span></div>

      <form method="post" action="/api/auth/signup">
        <div class="field">
          <label for="displayName">Display name</label>
          <input class="input" id="displayName" name="displayName" type="text" required maxlength="40" autocomplete="nickname" placeholder="How should we address you?" />
        </div>
        <div class="field">
          <label for="email">Email</label>
          <input class="input" id="email" name="email" type="email" required autocomplete="email" placeholder="you@example.com" />
        </div>
        <div class="field">
          <label for="password">Password</label>
          <input class="input" id="password" name="password" type="password" required minlength="8" autocomplete="new-password" placeholder="At least 8 characters" />
          <div class="strength" aria-hidden="true">
            <span class="strength-bar" id="strengthBar"></span>
          </div>
          <p class="hint" id="strengthText">Passwords are hashed with PBKDF2 — we never store them in plaintext.</p>
        </div>
        <div class="field">
          <label for="confirmPassword">Confirm password</label>
          <input class="input" id="confirmPassword" name="confirmPassword" type="password" required minlength="8" autocomplete="new-password" placeholder="Repeat your password" />
        </div>

        <p class="terms-note">
          By creating an account you agree to the
          <a class="link" href="/legal/terms">Terms of Service</a> and
          <a class="link" href="/legal/privacy">Privacy Policy</a>.
        </p>

        <button class="btn btn--primary btn--block btn--lg" type="submit">Create account</button>
      </form>

      <div class="auth-alt">
        Already have an account? <a class="link" href="/auth/signin">Sign in</a>
      </div>
    </div>
  </section>
</MarketingLayout>

<script>
  const input = document.getElementById('password') as HTMLInputElement | null;
  const bar = document.getElementById('strengthBar');
  const text = document.getElementById('strengthText');
  if (input && bar && text) {
    const labels = [
      { min: 0, label: 'Too short', cls: '' },
      { min: 8, label: 'Weak', cls: 'weak' },
      { min: 12, label: 'Okay', cls: 'ok' },
      { min: 16, label: 'Strong', cls: 'strong' },
    ];
    input.addEventListener('input', () => {
      const v = input.value;
      let score = 0;
      if (v.length >= 8) score += 1;
      if (v.length >= 12) score += 1;
      if (/[A-Z]/.test(v) && /[a-z]/.test(v)) score += 1;
      if (/\d/.test(v)) score += 1;
      if (/[^A-Za-z0-9]/.test(v)) score += 1;
      bar.className = 'strength-bar ' + (score >= 4 ? 'strong' : score >= 3 ? 'ok' : score >= 2 ? 'weak' : '');
      text.textContent = score >= 4 ? 'Strong password.' : score >= 3 ? 'Decent — add one more character type to be safe.' : 'Use a longer mix of letters, numbers, and symbols.';
    });
  }
</script>

<style>
  .auth-wrap {
    display: grid;
    place-items: center;
    padding: clamp(48px, 10vw, 96px) 20px;
  }
  .auth-card { width: 100%; max-width: 440px; }
  .auth-head { text-align: center; margin-bottom: 24px; }
  .auth-head h1 { font-size: 1.7rem; margin-bottom: 6px; }
  .auth-head p { color: var(--text-dim); font-size: 0.95rem; margin: 0; }
  .terms-note { font-size: 0.82rem; color: var(--text-faint); margin: 0 0 18px; }
  .auth-alt { text-align: center; margin-top: 22px; font-size: 0.92rem; color: var(--text-dim); }
  .or-divider {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 18px 0;
    color: var(--text-faint);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .or-divider::before,
  .or-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--border);
  }
  .strength { height: 4px; border-radius: 2px; background: var(--border); margin-top: 8px; overflow: hidden; }
  .strength-bar { display: block; height: 100%; width: 0; border-radius: 2px; transition: width 0.2s ease, background 0.2s ease; }
  .strength-bar.weak { width: 33%; background: var(--red); }
  .strength-bar.ok { width: 66%; background: var(--amber); }
  .strength-bar.strong { width: 100%; background: var(--green); }
</style>
