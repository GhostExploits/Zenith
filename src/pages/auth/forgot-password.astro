---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import Icon from '../../components/icons/Icon.astro';

const sent = Astro.url.searchParams.get('sent');
const error = Astro.url.searchParams.get('error');
---

<MarketingLayout title="Forgot password" description="Reset your Zenith password." noindex>
  <section class="auth-wrap">
    <div class="auth-card card card--pad-lg">
      <div class="auth-head">
        <h1>Reset your password</h1>
        <p>Enter the email on your account and we'll send you a reset link.</p>
      </div>

      {sent && (
        <div class="form-success">
          <Icon name="mail" size={16} />
          If an account exists for that email, you’ll receive a reset link shortly. Check your inbox (and spam folder). The link expires after 1 hour.
        </div>
      )}
      {error === 'rate_limited' && <div class="form-error"><Icon name="alert-triangle" size={16} /> Too many attempts. Please wait a few minutes.</div>}

      {!sent && (
        <form method="post" action="/api/auth/forgot-password">
          <div class="field">
            <label for="email">Email</label>
            <input class="input" id="email" name="email" type="email" required autocomplete="email" placeholder="you@example.com" />
          </div>
          <button class="btn btn--primary btn--block btn--lg" type="submit">Send reset link</button>
        </form>
      )}

      <div class="auth-alt">
        Remembered it? <a class="link" href="/auth/signin">Back to sign in</a>
      </div>
    </div>
  </section>
</MarketingLayout>

<style>
  .auth-wrap { display: grid; place-items: center; padding: clamp(48px, 10vw, 96px) 20px; }
  .auth-card { width: 100%; max-width: 440px; }
  .auth-head { text-align: center; margin-bottom: 24px; }
  .auth-head h1 { font-size: 1.7rem; margin-bottom: 6px; }
  .auth-head p { color: var(--text-dim); font-size: 0.95rem; margin: 0; }
  .auth-alt { text-align: center; margin-top: 22px; font-size: 0.92rem; color: var(--text-dim); }
</style>
