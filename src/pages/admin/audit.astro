---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/icons/Icon.astro';
import { requireAdmin } from '../../lib/server/guard';
import { formatRelative } from '../../lib/format';

const session = await requireAdmin(Astro);
if (session instanceof Response) return session;
const { user, store } = session;
const db = store.db();
const entries = db.audit.slice().reverse();
---

<AdminLayout title="Audit log" user={user}>
  <div class="app-main-header">
    <div>
      <h1>Audit log</h1>
      <p>Every administrative action, recorded with actor and timestamp.</p>
    </div>
  </div>

  {
    entries.length === 0 ? (
      <div class="empty-state">
        <div class="empty-icon"><Icon name="activity" size={36} /></div>
        <h3>No audit events yet</h3>
        <p>Administrative actions will be recorded here.</p>
      </div>
    ) : (
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr>
              <th>Time</th>
              <th>Actor</th>
              <th>Action</th>
              <th>Resource</th>
              <th>Details</th>
              <th>IP</th>
            </tr>
          </thead>
          <tbody>
            {entries.map((e) => (
              <tr>
                <td class="faint small">{formatRelative(e.createdAt)}</td>
                <td class="muted">{e.actorEmail}</td>
                <td><span class="badge badge--accent" style="text-transform: none; letter-spacing: 0;">{e.action}</span></td>
                <td>{e.resource}</td>
                <td class="muted small">{e.details ?? '—'}</td>
                <td class="faint small">{e.ip ?? '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
</AdminLayout>
