---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/icons/Icon.astro';
import { requireAdmin } from '../../lib/server/guard';
import { formatDate } from '../../lib/format';

const session = await requireAdmin(Astro);
if (session instanceof Response) return session;
const { user, store } = session;
const db = store.db();
const productName = (id: string) => db.products.find((p) => p.id === id)?.name ?? id;
const releases = db.releases.sort((a, b) => (a.date < b.date ? 1 : -1));
const release = Astro.url.searchParams.get('id') ? db.releases.find((r) => r.id === Astro.url.searchParams.get('id')) : undefined;
const isNew = !release;
const action = isNew ? 'create' : 'update';

const f = (key: string, fallback = '') => {
  const val = release?.[key as keyof typeof release];
  return val === undefined || val === null ? String(fallback) : String(val);
};
const fArr = (key: string) => (release?.[key as keyof typeof release] as string[] | undefined) ?? [];
---

<AdminLayout title="Releases" user={user}>
  <div class="app-main-header">
    <div>
      <h1>Releases</h1>
      <p>Manage release versions, notes, channels, and download assets.</p>
    </div>
    <a class="btn btn--primary" href="/admin/releases?id=new"><Icon name="plus" size={16} /> New release</a>
  </div>

  {
    releases.length === 0 ? (
      <div class="empty-state"><h3>No releases yet</h3></div>
    ) : (
      <div class="table-wrap mb-3">
        <table class="table">
          <thead>
            <tr>
              <th>Version</th>
              <th>Product</th>
              <th>Title</th>
              <th>Date</th>
              <th>Channel</th>
              <th>State</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {releases.map((r) => (
              <tr>
                <td style="font-weight: 600; color: var(--accent);">{r.version}</td>
                <td>{productName(r.productId)}</td>
                <td class="muted">{r.title}</td>
                <td class="faint small">{formatDate(r.date)}</td>
                <td><span class="badge badge--accent">{r.channel}</span></td>
                <td>
                  {r.published
                    ? <span class="badge badge--green badge--dot">Published</span>
                    : <span class="badge">Draft</span>}
                  {r.scheduledFor && <span class="badge badge--blue mt-1">Scheduled</span>}
                </td>
                <td>
                  <div class="row" style="gap: 6px; justify-content: flex-end;">
                    <a class="btn btn--sm btn--secondary" href={`/admin/releases?id=${r.id}`}><Icon name="edit" size={14} /> Edit</a>
                    <a class="btn btn--sm btn--ghost" href={`/changelog/${r.id}`} target="_blank"><Icon name="external" size={14} /></a>
                    <form method="post" action="/api/admin/releases" data-confirm={`Delete release ${r.version}?`}>
                      <input type="hidden" name="action" value="delete" />
                      <input type="hidden" name="id" value={r.id} />
                      <button class="btn btn--sm btn--danger" type="submit"><Icon name="trash" size={14} /></button>
                    </form>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }

  <div class="card card--pad-lg" id="form">
    <h2 class="sec-title">{isNew ? 'Create release' : `Edit — ${release?.version}`}</h2>
    <form method="post" action="/api/admin/releases" style="max-width: 760px;">
      <input type="hidden" name="action" value={action} />
      {!isNew && <input type="hidden" name="id" value={release!.id} />}
      <div class="grid grid--3">
        <div class="field">
          <label for="productId">Product *</label>
          <select class="select" id="productId" name="productId" required>
            {db.products.map((p) => <option value={p.id} selected={f('productId') === p.id}>{p.name}</option>)}
          </select>
        </div>
        <div class="field">
          <label for="version">Version *</label>
          <input class="input" id="version" name="version" required value={f('version')} placeholder="0.4.2-beta" />
        </div>
        <div class="field">
          <label for="title">Title *</label>
          <input class="input" id="title" name="title" required value={f('title')} placeholder="Beta 0.4.2" />
        </div>
      </div>
      <div class="grid grid--3">
        <div class="field">
          <label for="date">Release date</label>
          <input class="input" id="date" name="date" type="date" value={f('date', new Date().toISOString().slice(0, 10))} />
        </div>
        <div class="field">
          <label for="channel">Channel</label>
          <select class="select" id="channel" name="channel">
            {['stable', 'beta', 'dev'].map((c) => <option value={c} selected={f('channel') === c}>{c}</option>)}
          </select>
        </div>
        <div class="field">
          <label for="scheduledFor">Scheduled for (optional)</label>
          <input class="input" id="scheduledFor" name="scheduledFor" type="date" value={f('scheduledFor')} />
        </div>
      </div>
      <div class="field">
        <label for="summary">Summary</label>
        <textarea class="textarea" id="summary" name="summary" style="min-height: 60px;">{f('summary')}</textarea>
      </div>
      <div class="field">
        <label for="sections">Release notes — format: "Added|item1, item2" per line (one section per line)</label>
        <textarea class="textarea" id="sections" name="sections" style="min-height: 130px;" placeholder={'Added|Aim assist presets, HUD editor\nImproved|Faster startup\nFixed|Crash on 1.21.x'}>
          {release?.sections.map((s) => `${s.title}|${s.items.join(', ')}`).join('\n') ?? ''}
        </textarea>
      </div>
      <div class="grid grid--2">
        <div class="field">
          <label for="minecraftVersions">Minecraft versions (comma-separated)</label>
          <input class="input" id="minecraftVersions" name="minecraftVersions" value={fArr('minecraftVersions').join(', ')} placeholder="1.8.9, 1.12.2" />
        </div>
        <div class="field">
          <label for="platforms">Platforms (comma-separated)</label>
          <input class="input" id="platforms" name="platforms" value={fArr('platforms').join(', ')} placeholder="Windows 10/11, macOS, Linux" />
        </div>
      </div>
      <div class="grid grid--3">
        <div class="field">
          <label for="assetFilename">Asset filename</label>
          <input class="input" id="assetFilename" name="assetFilename" value={f('assetFilename', `${f('version', 'release')}.jar`)} placeholder="Zenith-V2.jar" />
        </div>
        <div class="field">
          <label for="assetSize">Size (bytes)</label>
          <input class="input" id="assetSize" name="assetSize" type="number" min="0" value={f('assetSize')} />
        </div>
        <div class="field">
          <label for="assetSha256">SHA-256</label>
          <input class="input" id="assetSha256" name="assetSha256" value={f('assetSha256', '[RELEASE_SHA256]')} />
        </div>
      </div>
      <div class="row" style="gap: 22px; flex-wrap: wrap; margin-bottom: 18px;">
        <label class="check"><input type="checkbox" name="published" value="true" checked={release?.published} /> Published (visible on public site)</label>
        <label class="check"><input type="checkbox" name="featured" value="true" checked={release?.featured} /> Featured</label>
        <label class="check"><input type="checkbox" name="requiresEntitlement" value="true" checked={release?.requiresEntitlement !== false} /> Requires entitlement</label>
      </div>
      <button class="btn btn--primary" type="submit">{isNew ? 'Create release' : 'Save changes'}</button>
    </form>
  </div>
</AdminLayout>

<style>
  .sec-title { font-size: 0.78rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-faint); margin-bottom: 16px; }
  .check { display: flex; align-items: center; gap: 8px; font-size: 0.92rem; color: var(--text-dim); cursor: pointer; }
  .check input { accent-color: var(--accent); width: 16px; height: 16px; }
</style>

<script>
  document.querySelectorAll<HTMLFormElement>('form[data-confirm]').forEach((form) => {
    form.addEventListener('submit', (e) => { if (!window.confirm(form.dataset.confirm ?? '')) e.preventDefault(); });
  });
</script>
