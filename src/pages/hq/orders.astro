---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/icons/Icon.astro';
import { requireAdmin } from '../../lib/server/guard';
import { formatPrice, formatRelative } from '../../lib/format';

const session = await requireAdmin(Astro);
if (session instanceof Response) return session;
const { user, store } = session;
const db = store.db();

const userEmail = (id: string) => db.users.find((u) => u.id === id)?.email ?? id;
const planName = (id: string) => db.plans.find((p) => p.id === id)?.name ?? id;
const productName = (id: string) => db.products.find((p) => p.id === id)?.name ?? id;

const paid = db.purchases.filter((p) => p.status === 'paid');
const revenue = paid.reduce((sum, p) => sum + (p.amountCents ?? 0), 0);
const stats = [
  { label: 'Revenue (paid)', value: formatPrice(revenue, 'USD'), icon: 'credit-card' },
  { label: 'Paid orders', value: paid.length, icon: 'check' },
  { label: 'Pending', value: db.purchases.filter((p) => p.status === 'pending').length, icon: 'clock' },
  { label: 'Refunded', value: db.purchases.filter((p) => p.status === 'refunded').length, icon: 'refresh' },
  { label: 'Failed', value: db.purchases.filter((p) => p.status === 'failed').length, icon: 'alert-triangle' },
];

const query = Astro.url.searchParams.get('q')?.toLowerCase() ?? '';
const orders = db.purchases
  .filter(
    (p) =>
      !query ||
      userEmail(p.userId).toLowerCase().includes(query) ||
      (p.providerRef ?? '').toLowerCase().includes(query) ||
      planName(p.planId).toLowerCase().includes(query) ||
      p.id.toLowerCase().includes(query),
  )
  .sort((a, b) => (a.createdAt < b.createdAt ? 1 : -1));
---

<AdminLayout title="Orders" user={user}>
  <div class="app-main-header">
    <div>
      <h1>Orders</h1>
      <p>Every purchase and renewal, recorded from verified payment events.</p>
    </div>
    <form method="get" class="row" style="gap: 8px;">
      <input class="input" type="search" name="q" value={query} placeholder="Search email, plan, or reference…" aria-label="Search orders" style="width: 260px;" />
      <button class="btn btn--secondary" type="submit"><Icon name="search" size={16} /></button>
    </form>
  </div>

  <div class="stat-grid mb-3">
    {stats.map((s) => (
      <div class="card card--pad stat-card">
        <div class="stat-label"><Icon name={s.icon} size={14} class="stat-icon" style="vertical-align: -2px; margin-right: 6px;" /> {s.label}</div>
        <div class="stat-value">{s.value}</div>
      </div>
    ))}
  </div>

  <div class="table-wrap">
    <table class="table">
      <thead>
        <tr>
          <th>Customer</th>
          <th>Product</th>
          <th>Plan</th>
          <th>Amount</th>
          <th>Status</th>
          <th>Date</th>
          <th>Reference</th>
        </tr>
      </thead>
      <tbody>
        {orders.map((p) => (
          <tr>
            <td class="muted">{userEmail(p.userId)}</td>
            <td>{productName(p.productId)}</td>
            <td style="font-weight: 600;">{planName(p.planId)}</td>
            <td>{formatPrice(p.amountCents, p.currency)}</td>
            <td>
              {p.status === 'paid' ? <span class="badge badge--green badge--dot">Paid</span>
                : p.status === 'pending' ? <span class="badge badge--blue badge--dot">Pending</span>
                : p.status === 'refunded' ? <span class="badge badge--red badge--dot">Refunded</span>
                : <span class="badge">Failed</span>}
            </td>
            <td class="faint small">{formatRelative(p.createdAt)}</td>
            <td class="faint small mono">{p.providerRef ?? '—'}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  {orders.length === 0 && (
    <div class="empty-state mt-2">
      <div class="empty-icon"><Icon name="credit-card" size={36} /></div>
      <h3>{query ? 'No orders match your search' : 'No orders yet'}</h3>
      <p>Orders are recorded automatically from verified payment events.</p>
    </div>
  )}

  <div class="alert alert--info mt-3">
    <Icon name="shield-check" size={18} />
    <span>Orders are only created from provider webhooks with verified signatures — a payment can never be granted from the browser.</span>
  </div>
</AdminLayout>

<style>
  .mono { font-family: var(--font-mono); font-size: 0.75rem; }
  .stat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 14px; }
</style>
