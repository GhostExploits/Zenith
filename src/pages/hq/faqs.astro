---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/icons/Icon.astro';
import { requireAdmin } from '../../lib/server/guard';
import ConfirmDialog from '../../components/ConfirmDialog.astro';

const session = await requireAdmin(Astro);
if (session instanceof Response) return session;
const { user, store } = session;
const db = store.db();
const faqs = db.faqs;
const faq = Astro.url.searchParams.get('id') ? db.faqs.find((f) => f.id === Astro.url.searchParams.get('id')) : undefined;
const isNew = !faq;
const action = isNew ? 'create' : 'update';

const f = (key: string, fallback = '') => {
  const val = faq?.[key as keyof typeof faq];
  return val === undefined || val === null ? String(fallback) : String(val);
};
---

<AdminLayout title="FAQs" user={user}>
  <div class="app-main-header">
    <div>
      <h1>FAQs</h1>
      <p>Edit the FAQ catalog. Published entries appear on the FAQ page.</p>
    </div>
    <a class="btn btn--primary" href="/hq/faqs?id=new"><Icon name="plus" size={16} /> New FAQ</a>
  </div>

  {
    faqs.length === 0 ? (
      <div class="empty-state"><h3>No FAQs yet</h3></div>
    ) : (
      <div class="table-wrap mb-3">
        <table class="table">
          <thead>
            <tr>
              <th>Category</th>
              <th>Question</th>
              <th>Status</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {faqs.map((q) => (
              <tr>
                <td><span class="badge">{q.category}</span></td>
                <td>{q.question}</td>
                <td>{q.published ? <span class="badge badge--green badge--dot">Published</span> : <span class="badge">Draft</span>}</td>
                <td>
                  <div class="row" style="gap: 6px; justify-content: flex-end;">
                    <a class="btn btn--sm btn--secondary" href={`/hq/faqs?id=${q.id}`}><Icon name="edit" size={14} /> Edit</a>
                    <form method="post" action="/api/admin/faqs" data-confirm="Delete this FAQ?">
                      <input type="hidden" name="action" value="delete" />
                      <input type="hidden" name="id" value={q.id} />
                      <button class="btn btn--sm btn--danger" type="submit"><Icon name="trash" size={14} /></button>
                    </form>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }

  <div class="card card--pad-lg" id="form">
    <h2 class="sec-title">{isNew ? 'Create FAQ' : 'Edit FAQ'}</h2>
    <form method="post" action="/api/admin/faqs" style="max-width: 720px;">
      <input type="hidden" name="action" value={action} />
      {!isNew && <input type="hidden" name="id" value={faq!.id} />}
      <div class="grid grid--2">
        <div class="field">
          <label for="category">Category</label>
          <input class="input" id="category" name="category" value={f('category')} placeholder="Getting Started" />
        </div>
        <div class="field">
          <label class="check" style="margin-top: 26px;"><input type="checkbox" name="published" value="true" checked={faq?.published !== false} /> Published</label>
        </div>
      </div>
      <div class="field">
        <label for="question">Question *</label>
        <input class="input" id="question" name="question" required value={f('question')} />
      </div>
      <div class="field">
        <label for="answer">Answer *</label>
        <textarea class="textarea" id="answer" name="answer" required style="min-height: 120px;">{f('answer')}</textarea>
      </div>
      <button class="btn btn--primary" type="submit">{isNew ? 'Create FAQ' : 'Save changes'}</button>
    </form>
  </div>
<ConfirmDialog />
</AdminLayout>

<style>
  .sec-title { font-size: 0.78rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-faint); margin-bottom: 16px; }
  .check { display: flex; align-items: center; gap: 8px; font-size: 0.92rem; color: var(--text-dim); cursor: pointer; }
  .check input { accent-color: var(--accent); width: 16px; height: 16px; }
</style>


