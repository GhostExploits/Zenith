---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/icons/Icon.astro';
import ConfirmDialog from '../../components/ConfirmDialog.astro';
import { requireAdmin } from '../../lib/server/guard';
import { ROLE_RANK } from '../../lib/server/auth';
import { formatRelative } from '../../lib/format';

const session = await requireAdmin(Astro);
if (session instanceof Response) return session;
const { user, store } = session;
const db = store.db();

const roles = ['user', 'moderator', 'support', 'admin', 'owner'] as const;
const query = Astro.url.searchParams.get('q')?.toLowerCase() ?? '';
const users = db.users
  .filter((u) => !query || u.email.includes(query) || u.displayName.toLowerCase().includes(query))
  .sort((a, b) => (a.createdAt < b.createdAt ? 1 : -1));
---

<AdminLayout title="Users" user={user}>
  <div class="app-main-header">
    <div>
      <h1>Users</h1>
      <p>Search accounts, manage roles, and suspend accounts when policy requires.</p>
    </div>
    <form method="get" class="row" style="gap: 8px;">
      <input class="input" type="search" name="q" value={query} placeholder="Search email or name…" aria-label="Search users" style="width: 240px;" />
      <button class="btn btn--secondary" type="submit"><Icon name="search" size={16} /></button>
    </form>
  </div>

  <div class="table-wrap">
    <table class="table">
      <thead>
        <tr>
          <th>User</th>
          <th>Email</th>
          <th>Role</th>
          <th>Status</th>
          <th>Joined</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        {users.map((u) => (
          <tr>
            <td>
              <div style="font-weight: 600;">{u.displayName}</div>
              {u.id === user.id && <span class="badge badge--accent" style="margin-top: 4px;">You</span>}
            </td>
            <td class="muted">{u.email} {!u.emailVerified && <span class="badge">unverified</span>}</td>
            <td><span class="badge badge--violet">{u.role}</span></td>
            <td>
              {u.suspended
                ? <span class="badge badge--red badge--dot">Suspended</span>
                : <span class="badge badge--green badge--dot">Active</span>}
            </td>
            <td class="faint small">{formatRelative(u.createdAt)}</td>
            <td>
              {
                u.id === user.id ? (
                  <span class="faint small">—</span>
                ) : (
                  <div class="row" style="gap: 8px; flex-wrap: wrap;">
                    <form method="post" action="/api/admin/users" class="row" style="gap: 6px;">
                      <input type="hidden" name="action" value="update_role" />
                      <input type="hidden" name="id" value={u.id} />
                      <select class="select" name="role" style="width: auto; padding: 6px 10px; font-size: 0.82rem;" disabled={ROLE_RANK[u.role] >= ROLE_RANK[user.role]}>
                        {roles.map((r) => <option value={r} selected={u.role === r}>{r}</option>)}
                      </select>
                      <button class="btn btn--sm btn--secondary" type="submit" disabled={ROLE_RANK[u.role] >= ROLE_RANK[user.role]}>Set</button>
                    </form>
                    <form method="post" action="/api/admin/users" data-confirm={u.suspended ? `Reinstate ${u.displayName}?` : `Suspend ${u.displayName}? They'll be signed out immediately and lose access.`}>
                      <input type="hidden" name="action" value="update_status" />
                      <input type="hidden" name="id" value={u.id} />
                      <input type="hidden" name="suspended" value={u.suspended ? 'false' : 'true'} />
                      <button class={`btn btn--sm ${u.suspended ? 'btn--secondary' : 'btn--danger'}`} type="submit">
                        {u.suspended ? 'Reinstate' : 'Suspend'}
                      </button>
                    </form>
                  </div>
                )
              }
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  {users.length === 0 && <div class="empty-state mt-2"><h3>No users found</h3></div>}

  <div class="alert alert--info mt-3">
    <Icon name="info" size={18} />
    <span>Passwords are never stored in plaintext and are not readable here. Role changes and suspensions are recorded in the audit log.</span>
  </div>
  <ConfirmDialog />
</AdminLayout>
