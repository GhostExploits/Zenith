---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/icons/Icon.astro';
import { requireAdmin } from '../../lib/server/guard';

const session = await requireAdmin(Astro);
if (session instanceof Response) return session;
const { user, store } = session;
const content = store.db().content;
const saved = Astro.url.searchParams.get('saved');
---

<AdminLayout title="Site content" user={user}>
  <div class="app-main-header">
    <div>
      <h1>Site content</h1>
      <p>Edit marketing copy and links. Values are whitelisted field-by-field — no raw code editing.</p>
    </div>
  </div>

  {saved && <div class="form-success mb-2"><Icon name="check" size={16} /> Content saved.</div>}

  <form method="post" action="/api/admin/content" style="max-width: 760px;">
    <div class="card card--pad mb-2">
      <h2 class="sec-title">Hero</h2>
      <div class="field">
        <label for="heroTitle">Hero title</label>
        <input class="input" id="heroTitle" name="heroTitle" value={content.heroTitle} />
      </div>
      <div class="field">
        <label for="heroSubtitle">Hero subtitle</label>
        <textarea class="textarea" id="heroSubtitle" name="heroSubtitle" style="min-height: 70px;">{content.heroSubtitle}</textarea>
      </div>
      <div class="grid grid--2">
        <div class="field">
          <label for="heroCtaPrimary">Primary CTA label</label>
          <input class="input" id="heroCtaPrimary" name="heroCtaPrimary" value={content.heroCtaPrimary} />
        </div>
        <div class="field">
          <label for="heroCtaSecondary">Secondary CTA label</label>
          <input class="input" id="heroCtaSecondary" name="heroCtaSecondary" value={content.heroCtaSecondary} />
        </div>
      </div>
    </div>

    <div class="card card--pad mb-2">
      <h2 class="sec-title">Links</h2>
      <div class="field">
        <label for="discordUrl">Discord URL</label>
        <input class="input" id="discordUrl" name="discordUrl" value={content.discordUrl} placeholder="[DISCORD_LINK]" />
      </div>
      <div class="field">
        <label for="supportUrl">Support URL</label>
        <input class="input" id="supportUrl" name="supportUrl" value={content.supportUrl} placeholder="[SUPPORT_LINK]" />
      </div>
    </div>

    <div class="card card--pad mb-2">
      <h2 class="sec-title">Announcement banner</h2>
      <div class="field">
        <label for="announcementBanner">Banner text</label>
        <input class="input" id="announcementBanner" name="announcementBanner" value={content.announcementBanner} />
      </div>
      <label class="check"><input type="checkbox" name="announcementBannerActive" value="true" checked={content.announcementBannerActive} /> Show banner on the home page</label>
    </div>

    <button class="btn btn--primary btn--lg" type="submit">Save content</button>
  </form>
</AdminLayout>

<style>
  .sec-title { font-size: 0.78rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-faint); margin-bottom: 16px; }
  .check { display: flex; align-items: center; gap: 8px; font-size: 0.92rem; color: var(--text-dim); cursor: pointer; }
  .check input { accent-color: var(--accent); width: 16px; height: 16px; }
</style>
