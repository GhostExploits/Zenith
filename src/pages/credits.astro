---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import { site } from '../config/site';
---

<!--
  Credits — a signed page. The subject here is a person, so the page is
  designed like a sign-off: one ruled signature block instead of a stack of
  feature cards. The hero IS the signature.
-->
<MarketingLayout
  title="Credits"
  description={`${site.name} was designed, built, and shipped by zach.cww.`}
>
  <section class="page-hero credits-hero">
    <div class="container">
      <span class="eyebrow">Credits</span>
      <h1 data-parallax data-depth="3">Every layer, one pair of hands.</h1>
      <p>
        Zenith — the client, the launcher, the website you're reading, and the
        license system behind it — was designed, built, and shipped by
        zach.cww. No studio, no team, no agency. One person, end to end.
      </p>
    </div>
  </section>

  <section class="section" data-reveal>
    <div class="container container--narrow">
      <!-- The signature — the one thing this page exists to say -->
      <div class="signature">
        <span class="signature__rule" aria-hidden="true"></span>
        <div class="signature__name">zach.cww</div>
        <div class="signature__meta">design · engineering · the whole thing</div>
        <span class="signature__rule" aria-hidden="true"></span>
      </div>

      <p class="credits-note">
        If something feels broken, one person is also human. Report it in the
        community and it gets fixed — usually fast.
      </p>
    </div>
  </section>
</MarketingLayout>

<style>
  .credits-hero {
    text-align: center;
  }

  .credits-hero .eyebrow {
    justify-content: center;
  }

  .credits-hero .eyebrow::after {
    content: '';
    width: 18px;
    height: 1px;
    background: currentColor;
    opacity: 0.75;
  }

  .credits-hero h1 {
    font-size: clamp(2rem, 4.6vw, 3.1rem);
    font-weight: 680;
    letter-spacing: -0.03em;
  }

  .credits-hero p {
    margin-inline: auto;
    max-width: 560px;
    color: var(--text-dim);
    font-size: 1.02rem;
    line-height: 1.6;
  }

  .signature {
    display: grid;
    justify-items: center;
    gap: 22px;
    padding: clamp(40px, 8vw, 72px) 0;
  }

  .signature__rule {
    width: 56px;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent-dim), transparent);
    opacity: 0.5;
  }

  /* The name rendered like a document sign-off — mono, spaced, final. */
  .signature__name {
    font-family: var(--font-mono);
    font-size: clamp(1.7rem, 4.4vw, 2.7rem);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: lowercase;
    color: var(--text);
  }

  .signature__meta {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin-top: -10px;
  }

  .credits-note {
    text-align: center;
    color: var(--text-faint);
    font-size: 0.88rem;
    max-width: 460px;
    margin: 0 auto;
  }
</style>
