---
import AppLayout, { type AppLink } from '../../layouts/AppLayout.astro';
import Icon from '../../components/icons/Icon.astro';
import { requireUser } from '../../lib/server/guard';
import { ownedProductIds } from '../../lib/server/entitlements';
import { licenseEffectiveStatus, licenseStatusLabel } from '../../lib/server/licenses';
import { getProducts, getReleasesForProduct, getPlans } from '../../lib/server/catalog';

const session = await requireUser(Astro);
if (session instanceof Response) return session;
const { user, store } = session;
const db = store.db();

const nav: AppLink[] = [
  { label: 'Overview', href: '/account', icon: 'home' },
  { label: 'Products', href: '/account/products', icon: 'package' },
  { label: 'Subscriptions', href: '/account/subscriptions', icon: 'credit-card' },
  { label: 'Downloads', href: '/account/downloads', icon: 'download' },
  { label: 'Settings', href: '/account/settings', icon: 'settings' },
];

const owned = ownedProductIds(db, user);
const products = (await getProducts()).filter((p) => owned.includes(p.id));
const releasesByProduct = new Map<string, Awaited<ReturnType<typeof getReleasesForProduct>>>();
for (const p of products) releasesByProduct.set(p.id, await getReleasesForProduct(p.id));
const plans = await getPlans();
const planName = (id: string) => plans.find((p) => p.id === id)?.name ?? id;
---

<AppLayout title="Your products" user={{ displayName: user.displayName, role: user.role }} nav={nav} noindex>
  <div class="app-main-header">
    <div>
      <h1>Your products</h1>
      <p>Products you hold an entitlement for.</p>
    </div>
  </div>

  {
    products.length === 0 ? (
      <div class="empty-state">
        <div class="empty-icon"><Icon name="package" size={36} /></div>
        <h3>No products yet</h3>
        <p>When you purchase or subscribe to a product, it will appear here with its downloads.</p>
        <a class="btn btn--primary mt-2" href="/products">Browse products</a>
      </div>
    ) : (
      <div class="stack" style="gap: 20px;">
        {products.map((p) => {
          const releases = releasesByProduct.get(p.id) ?? [];
          const latest = releases[0];
          return (
            <div class="card card--pad">
              <div class="row row--between" style="flex-wrap: wrap; gap: 12px;">
                <div>
                  <div class="row" style="gap: 10px; margin-bottom: 6px; flex-wrap: wrap;">
                    <span class="badge badge--green badge--dot">Entitlement active</span>
                    <span class="badge">{p.channel}</span>
                  </div>
                  <h2 style="font-size: 1.3rem; margin: 0;">{p.name}</h2>
                </div>
                <a class="btn btn--primary" href={`/account/downloads?product=${p.id}`}>
                  <Icon name="download" size={16} /> Downloads
                </a>
              </div>

              <div class="grid grid--3 mt-2" style="grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));">
                <div class="mini-stat">
                  <span class="faint small">Current version</span>
                  <span>{latest?.version ?? p.currentVersion}</span>
                </div>
                <div class="mini-stat">
                  <span class="faint small">Release channel</span>
                  <span>{latest ? latest.channel : p.channel}</span>
                </div>
                <div class="mini-stat">
                  <span class="faint small">Last release</span>
                  <span>{latest ? latest.date.slice(0, 10) : '—'}</span>
                </div>
              </div>

              {
                (() => {
                  const myLicenses = db.licenses.filter((l) => l.userId === user.id && l.productId === p.id);
                  if (myLicenses.length === 0) return null;
                  return (
                    <div class="license-box mt-2">
                      <span class="faint small" style="text-transform: uppercase; letter-spacing: 0.1em;">Your license keys</span>
                      <div class="row" style="gap: 8px; flex-wrap: wrap; margin-top: 8px;">
                        {myLicenses.map((l) => {
                          const status = licenseEffectiveStatus(l);
                          return (
                            <span class="license-chip">
                              <span class="license-chip-key">{l.key}</span>
                              <span class="badge badge--accent">{l.tier}</span>
                              <span class:list={['badge', status === 'active' ? 'badge--green badge--dot' : '']}>{licenseStatusLabel(status)}</span>
                              <span class="faint small">
                                {planName(l.planId)}
                                {l.expiresAt && ` · ${l.expiresAt.slice(0, 10)}`}
                                {l.deviceId ? ' · bound to your PC' : ' · not activated yet'}
                              </span>
                            </span>
                          );
                        })}
                      </div>
                    </div>
                  );
                })()
              }

              <div class="row mt-2" style="gap: 8px; flex-wrap: wrap;">
                <a class="btn btn--sm btn--secondary" href={`/changelog?product=${p.id}`}>Changelog</a>
                <a class="btn btn--sm btn--ghost" href={`/products/${p.slug}`}>Product page</a>
                <a class="btn btn--sm btn--ghost" href="/account/subscriptions">Manage subscription</a>
              </div>
            </div>
          );
        })}
      </div>
    )
  }
</AppLayout>

<style>
  .mini-stat {
    display: grid;
    gap: 2px;
    padding: 12px 14px;
    background: var(--bg-inset);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font-weight: 600;
    font-size: 0.92rem;
  }
  .license-box {
    padding: 14px 16px;
    background: var(--bg-inset);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .license-chip {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    background: var(--bg-raised);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
  }
  .license-chip-key {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    color: var(--accent);
  }
</style>
