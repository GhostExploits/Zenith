---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import Icon from '../../components/icons/Icon.astro';
import { getSessionUser } from '../../lib/server/auth';
import { getStore } from '../../lib/server/store';

// Shown after Paddle redirects the buyer back. The real grant happens in the
// webhook; this page just orients the user.
const planName = (Astro.url.searchParams.get('plan') ?? '').slice(0, 80);
let signedIn = false;
try {
  const store = await getStore();
  signedIn = !!(await getSessionUser(store, Astro.request));
} catch {
  /* store unavailable */
}
---

<MarketingLayout
  title="Payment received"
  description="Your Zenith payment was received."
  noindex
>
  <section class="section">
    <div class="container container--narrow" style="text-align: center; padding-block: 6rem;">
      <div class="big-check"><Icon name="shield-check" size={44} /></div>
      <h1 style="font-size: 2rem; margin: 20px 0 8px;">Payment received</h1>
      <p class="muted" style="max-width: 520px; margin: 0 auto;">
        {planName
          ? <>Your <strong>{planName}</strong> order is being processed.</>
          : <>Your order is being processed.</>}
        {' '}Your license key is generated automatically and appears in your
        dashboard within a few seconds.
      </p>
      <div class="row center mt-3" style="gap: 10px; justify-content: center;">
        {
          signedIn ? (
            <a class="btn btn--primary btn--lg" href="/account/products">
              <Icon name="key" size={18} /> View your license
            </a>
          ) : (
            <a class="btn btn--primary btn--lg" href="/auth/signin">
              <Icon name="user" size={18} /> Sign in to view your license
            </a>
          )
        }
        <a class="btn btn--secondary btn--lg" href="/products">Browse products</a>
      </div>
      <p class="faint small mt-3" style="margin-bottom: 0;">
        Didn't receive it yet? It can take a minute for the payment confirmation
        to arrive. Refresh your dashboard shortly.
      </p>
    </div>
  </section>
</MarketingLayout>

<style>
  .big-check {
    width: 84px;
    height: 84px;
    margin: 0 auto;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--green-soft);
    color: var(--green);
    border: 1px solid rgba(92, 214, 138, 0.35);
  }
</style>
