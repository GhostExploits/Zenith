---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import Icon from '../../components/icons/Icon.astro';
import { getPlan, getProductById } from '../../lib/server/catalog';
import { getStore } from '../../lib/server/store';
import { getSessionUser } from '../../lib/server/auth';
import { hasEntitlement } from '../../lib/server/entitlements';
import { isPaymentsConfigured } from '../../lib/server/payments';
import { formatPrice, intervalLabel } from '../../lib/format';

const { planId } = Astro.params;
const plan = await getPlan(planId ?? '');
if (!plan) return Astro.redirect('/products');

const product = await getProductById(plan.productId);
if (!product || product.availability === 'unavailable') return Astro.redirect('/products');

let user: Awaited<ReturnType<typeof getSessionUser>> = null;
let alreadyOwned = false;
try {
  const store = await getStore();
  user = await getSessionUser(store, Astro.request);
  alreadyOwned = !!user && hasEntitlement(store.db(), user, product.id);
} catch {
  /* store unavailable — treat as guest */
}
const paymentsReady = isPaymentsConfigured();
---

<MarketingLayout title={`Checkout — ${plan.name}`} description={`${plan.name} plan for ${product.name}.`} noindex>
  <section class="section">
    <div class="container container--narrow">
      <div class="crumbs">
        <a href="/">Home</a>
        <Icon name="chevron-right" size={14} />
        <a href={`/products/${product.slug}`}>{product.name}</a>
        <Icon name="chevron-right" size={14} />
        <span>Checkout</span>
      </div>

      <h1 style="font-size: 1.8rem;">Checkout</h1>

      <div class="card card--pad-lg mt-2">
        <div class="row row--between" style="flex-wrap: wrap; gap: 12px;">
          <div>
            <div class="faint small" style="text-transform: uppercase; letter-spacing: 0.1em;">Product</div>
            <div style="font-weight: 600; margin-top: 4px;">{product.name}</div>
          </div>
          <div>
            <div class="faint small" style="text-transform: uppercase; letter-spacing: 0.1em;">Plan</div>
            <div style="font-weight: 600; margin-top: 4px;">{plan.name}</div>
          </div>
          <div>
            <div class="faint small" style="text-transform: uppercase; letter-spacing: 0.1em;">Billing</div>
            <div style="font-weight: 600; margin-top: 4px;">{intervalLabel(plan.interval)}</div>
          </div>
          <div>
            <div class="faint small" style="text-transform: uppercase; letter-spacing: 0.1em;">Total</div>
            <div class="plan-price" style="margin-top: 4px;">
              {formatPrice(plan.priceCents, plan.currency)}
              {plan.interval !== 'once' && <span class="faint small">/{plan.interval === 'month' ? 'month' : 'year'}</span>}
            </div>
          </div>
        </div>

        <hr class="divider" />

        <ul class="plan-check-list">
          {plan.features.map((f) => <li><Icon name="check" size={16} /> {f}</li>)}
        </ul>

        <hr class="divider" />

        <div class="license-note">
          <Icon name="key" size={16} />
          {plan.licenseMode === 'permanent'
            ? <>This purchase includes a <strong>permanent license</strong> — it never expires.</>
            : <>Your license stays valid while this subscription is active, and renews with each billing period.</>}
        </div>

        <hr class="divider" />

        {
          alreadyOwned ? (
            <div class="alert alert--green">
              <Icon name="shield-check" size={18} />
              You already hold an entitlement for {product.name}. Head to your dashboard to manage it.
            </div>
          ) : !user ? (
            <div class="alert alert--accent">
              <Icon name="user" size={18} />
              Sign in to continue — your purchase and license will be attached to your account.
            </div>
          ) : !paymentsReady ? (
            <div class="alert alert--maintenance">
              <Icon name="alert-triangle" size={18} />
              <span>
                <strong>Payments under maintenance.</strong>{' '}
                Payments are temporarily unavailable while Zenith's payment system is being
                finalized. Please check back soon.
              </span>
            </div>
          ) : null
        }

        <div class="mt-2">
          {
            user ? (
              alreadyOwned ? (
                <a class="btn btn--secondary btn--block btn--lg" href="/account/products">
                  Go to your dashboard
                </a>
              ) : (
                <form method="post" action="/api/payments/checkout">
                  <input type="hidden" name="planId" value={plan.id} />
                  <button class="btn btn--primary btn--block btn--lg" type="submit" disabled={!paymentsReady}>
                    <Icon name="lock" size={18} />
                    {paymentsReady ? `Pay ${formatPrice(plan.priceCents, plan.currency)} — secure checkout` : 'Payments unavailable'}
                  </button>
                </form>
              )
            ) : (
              <a class="btn btn--primary btn--block btn--lg" href={`/auth/signin?next=/checkout/${plan.id}`}>
                Sign in to continue
              </a>
            )
          }
        </div>
        <p class="faint small center mt-2" style="margin-bottom: 0;">
          {paymentsReady
            ? <>Checkout runs on a secure hosted payment page — card details never touch this site. Your license is granted automatically once the payment is confirmed.</>
            : <>Nothing on this page can charge you while payments are under maintenance. No payment details are collected.</>}
        </p>
      </div>
    </div>
  </section>
</MarketingLayout>

<style>
  .plan-price {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
  }
  .plan-check-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .plan-check-list li {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--text-dim);
    font-size: 0.94rem;
  }
  .license-note {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--text-dim);
    font-size: 0.9rem;
  }
  .license-note svg { color: var(--accent); flex-shrink: 0; }
  .alert--green {
    border-color: rgba(92, 214, 138, 0.35);
    background: var(--green-soft);
    color: var(--green);
  }
  .alert--maintenance {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    border-color: rgba(233, 182, 74, 0.4);
    background: var(--accent-soft);
    color: var(--amber);
  }
  .alert--maintenance svg { flex-shrink: 0; margin-top: 1px; }
</style>
